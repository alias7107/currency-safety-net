# Low-resource research pilot environment template (Phase 4B.1).
# Copy to deploy/.env.pilot and replace placeholders. Never commit real secrets.
#
# Placeholder domain (non-.kz): research-pilot.example.com
# Same-origin: https://research-pilot.example.com/ and /api/
#
# REQUIRED — must be set before startup (fail-closed Django/Compose):
# OPTIONAL — defaults exist; keep unless you have a measured reason to change.

# --- REQUIRED: site identity / TLS ---
CADDY_SITE_ADDRESS=research-pilot.example.com
CADDY_ACME_EMAIL=ops@research-pilot.example.com

# --- REQUIRED: Django production ---
DEBUG=False
DJANGO_SECRET_KEY=replace-with-long-random-secret-at-least-50-chars
ALLOWED_HOSTS=research-pilot.example.com
# Same-origin pilot: CORS may remain empty.
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=https://research-pilot.example.com
ADMIN_ENABLED=False

# --- REQUIRED: PostgreSQL ---
POSTGRES_DB=csn
POSTGRES_USER=csn
POSTGRES_PASSWORD=replace-with-strong-db-password
DATABASE_URL=postgres://csn:replace-with-strong-db-password@postgres:5432/csn
# OPTIONAL
DATABASE_CONN_MAX_AGE=60

# --- REQUIRED: Redis namespaces (must remain distinct) ---
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
REDIS_CACHE_URL=redis://redis:6379/2
CELERY_TASK_ALWAYS_EAGER=False

# --- REQUIRED for low-resource API process (also hardcoded in compose.low-resource.yaml) ---
GUNICORN_WORKERS=1
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=60

# --- OPTIONAL: Celery worker knobs (commands already pin concurrency/prefetch/max-tasks) ---
# Combined pilot worker queues are set in Compose: celery,buffer_sensitivity
# CELERY_WORKER_CONCURRENCY=1
# CELERY_WORKER_PREFETCH_MULTIPLIER=1
# CELERY_WORKER_MAX_TASKS_PER_CHILD=1

# --- Submissions: enabled by default for the demo pilot; freeze only in emergencies ---
OPTIMIZATION_SUBMISSIONS_ENABLED=True
BUFFER_SENSITIVITY_SUBMISSIONS_ENABLED=True

# --- Preserve existing application throttle defaults (do not tighten for pilot) ---
DRF_OPTIMIZATION_SUBMIT_THROTTLE=3/hour
DRF_BUFFER_SENSITIVITY_SUBMIT_THROTTLE=2/hour
DRF_JOB_POLL_THROTTLE=120/min
DRF_MODEL_METADATA_THROTTLE=60/min

# --- OPTIONAL: task limits/leases (do not invent new values before host benchmarks) ---
OPTIMIZATION_TASK_SOFT_TIME_LIMIT=180
OPTIMIZATION_TASK_TIME_LIMIT=240
OPTIMIZATION_LEASE_SECONDS=300
BUFFER_SENSITIVITY_TASK_SOFT_TIME_LIMIT=600
BUFFER_SENSITIVITY_TASK_TIME_LIMIT=720
BUFFER_SENSITIVITY_LEASE_SECONDS=840
OPTIMIZATION_MAX_ATTEMPTS=2

# --- Retention / privacy ---
JOB_RETENTION_DAYS=7

# --- HTTPS behind Caddy ---
SECURE_SSL_REDIRECT=True
# Staged HSTS: keep 0 until HTTPS is stable on the real host, then raise deliberately.
SECURE_HSTS_SECONDS=0
SECURE_PROXY_SSL_HEADER_ENABLED=True
DATA_UPLOAD_MAX_MEMORY_SIZE=65536
