# Exclude secrets, local DBs, caches, and unrelated trees from Docker build context.
.git
.gitignore
**/.venv
**/__pycache__
**/*.pyc
**/.pytest_cache
**/node_modules
**/dist
**/.angular
frontend/dist
backend/db.sqlite3
backend/.venv
.env
.env.*
!.env.example
!deploy/.env.production.example
docs
manuscript
**/*.md
!README.md
.DS_Store
agent-transcripts
**/.cursor
