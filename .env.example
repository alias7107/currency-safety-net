# Copy to .env and adjust for local development.
# Never commit production secrets.

DEBUG=True
DJANGO_SECRET_KEY=dev-only-not-for-production-change-me
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:4200
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
CELERY_TASK_ALWAYS_EAGER=False
CELERY_BROKER_CONNECTION_TIMEOUT=2
CELERY_BROKER_CONNECTION_MAX_RETRIES=0

# Scoped throttles (in-memory; development-only)
DRF_OPTIMIZATION_SUBMIT_THROTTLE=3/hour
DRF_JOB_POLL_THROTTLE=120/min
DRF_MODEL_METADATA_THROTTLE=60/min

OPTIMIZATION_MAX_ATTEMPTS=2
OPTIMIZATION_LEASE_SECONDS=240
# Must be greater than CELERY_TASK_TIME_LIMIT (180) with >= 30s margin.
